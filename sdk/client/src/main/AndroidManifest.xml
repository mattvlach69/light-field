<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets tools talk to USB security keys / hardware tokens. required=false
         so it never filters out devices without USB host support. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Field recording (added for the Field tool) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <application>
        <service
            android:name="com.thelightphone.sdk.LightPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="com.thelightphone.sdk.field.FieldRecordingService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
        <!-- LightAudioService is not declared here. The Gradle plugin emits it
             into the manifests of tools that declare the detached-audio
             capability, so no other tool carries a mediaPlayback claim. -->
    </application>
</manifest>
